# Ejemplo de bloque nginx para exponer ComprasAI bajo /comprasAI en 192.168.10.10.
# NO tocar la location de /compras (demo alternativa existente en el mismo host).
#
# Incluir dentro del server{} existente del host.

location /comprasAI/ {
    proxy_pass http://127.0.0.1:8010/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /comprasAI;
}
